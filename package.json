{
  "name": "amazonas-turismo-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node src/server.js",
    "build": "vite build",
    "test:api": "vitest run tests/api/api.test.js",
    "test:e2e": "playwright test",
    "test:performance:catalog": "k6 run tests/performance/catalog-load.js",
    "test:performance:stress": "k6 run tests/performance/city-filter-stress.js",
    "git:init": "git init"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.3.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.2"
  }
}
